# MCPath Environment Configuration

# Core Proxy Settings
MCPATH_ENV=development
MCPATH_LOG_LEVEL=INFO
MCPATH_SERVER_CONFIG=config/server_config.json

# Backend & Persistence Settings
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mcpath
SQLITE_FALLBACK_URL=sqlite+aiosqlite:///mcpath.db
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Security Pipeline Thresholds
INTENT_SIMILARITY_THRESHOLD=0.70
BEHAVIOUR_DEVIATION_THRESHOLD=0.60
RESPONSE_RISK_THRESHOLD=0.65

# Model / API Keys (Optional - for secondary LLM classifier in Stage 5)
ANTHROPIC_API_KEY=

# Real MCP Server Paths
# Filesystem MCP: set to the absolute path(s) the server may access (one path for Windows cmd)
FILESYSTEM_ALLOWED_PATHS=C:\your\allowed\path

# Git MCP: set to the absolute path of the local git repository to expose
GIT_REPOSITORY_PATH=C:\path\to\your\repo

# Microsoft PostgreSQL MCP (postgres-mcp) Settings — Isolated Demo Database
POSTGRES_DEMO_HOST=localhost
POSTGRES_DEMO_PORT=5432
POSTGRES_DEMO_DB=mcpath_demo_db
POSTGRES_DEMO_USER=mcpath_demo_user
POSTGRES_DEMO_PASSWORD=your_secure_password
POSTGRES_MCP_CONNECTION_STRING=postgresql://mcpath_demo_user:your_secure_password@localhost:5432/mcpath_demo_db?sslmode=disable

