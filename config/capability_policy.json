{
  "policy_version": "1.0.0",
  "name": "Deterministic MCP Capability Risk Policy v1",
  "description": "Deterministic capability classification, compatibility rules, chain-risk scoring, and critical override thresholds for MCPath proxy.",
  "weights": {
    "data_sensitivity": 0.30,
    "action_sensitivity": 0.25,
    "external_exposure": 0.20,
    "chain_risk": 0.25
  },
  "scale_max": 3.0,
  "critical_path_override": {
    "enabled": true,
    "min_data_sensitivity": 2.0,
    "require_external_action": true,
    "require_external_destination": true,
    "classification": "HIGH",
    "override_score": 85.0,
    "explanation": "CRITICAL PATH OVERRIDE: Sensitive Data flows to External Action and Destination"
  },
  "unknown_path_handling": {
    "score": 75.0,
    "classification": "HIGH",
    "explanation": "CAPABILITY PATH: UNKNOWN / UNMODELED"
  },
  "chain_risk_policy": {
    "base_risk": 0.2,
    "transitions": {
      "sensitive_data_to_external_action": 3.0,
      "sensitive_data_to_write_action": 2.0,
      "sensitive_data_to_read_action": 1.0,
      "standard_data_to_external_action": 2.0,
      "standard_data_to_write_action": 1.0,
      "benign_data_to_benign_action": 0.1,
      "action_to_external_destination": 2.5,
      "action_to_internal_destination": 0.0,
      "cross_server_boundary_hop": 0.5
    },
    "sensitive_threshold": 2.0
  },
  "compatibility_rules": {
    "valid_transitions": [
      ["Agent", "Tool", "CAN_CALL"],
      ["Tool", "Data/Resource", "READS"],
      ["Tool", "Data/Resource", "WRITES"],
      ["Data/Resource", "Action", "FLOWS_TO"],
      ["Action", "External Destination", "SENDS_TO"]
    ],
    "require_consumed_data_match": true
  },
  "explicit_tool_rules": {
    "read_customer": {
      "data_target": "customer_pii",
      "operation": "READ",
      "action_type": "read_pii",
      "data_sensitivity": 3.0,
      "action_sensitivity": 1.0,
      "external_exposure": 0.0,
      "external_destination": null,
      "consumed_data_types": ["customer_id"]
    },
    "send_email": {
      "data_target": "email_outbox",
      "operation": "WRITE",
      "action_type": "external_communication",
      "data_sensitivity": 1.0,
      "action_sensitivity": 3.0,
      "external_exposure": 3.0,
      "external_destination": "external_recipient",
      "consumed_data_types": ["customer_pii", "filesystem_data", "database_records", "email_payload", "generic_data"]
    },
    "echo": {
      "data_target": "user_echo_buffer",
      "operation": "READ",
      "action_type": "echo_internal",
      "data_sensitivity": 0.0,
      "action_sensitivity": 0.0,
      "external_exposure": 0.0,
      "external_destination": null,
      "consumed_data_types": ["user_echo_buffer"]
    },
    "calculate": {
      "data_target": "numeric_operands",
      "operation": "READ",
      "action_type": "arithmetic_compute",
      "data_sensitivity": 0.0,
      "action_sensitivity": 0.0,
      "external_exposure": 0.0,
      "external_destination": null,
      "consumed_data_types": ["numeric_operands"]
