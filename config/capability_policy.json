      "data_sensitivity": 1.0,
      "action_sensitivity": 0.5,
      "external_exposure": 0.0,
      "external_destination": null,
      "consumed_data_types": ["git_repository_metadata"]
    },
    "delete_repository": {
      "data_target": "git_repository",
      "operation": "WRITE",
      "action_type": "destructive_deletion",
      "data_sensitivity": 2.0,
      "action_sensitivity": 3.0,
      "external_exposure": 0.0,
      "external_destination": null,
      "consumed_data_types": ["git_repository"]
