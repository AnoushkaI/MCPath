  "pattern_inference_rules": {
    "sensitive_data_patterns": [
      {"pattern": "(?i)(pii|ssn|social_security|customer_profile|credentials|password|secret|auth_token|credit_card)", "data_sensitivity": 3.0, "data_target": "sensitive_data"},
      {"pattern": "(?i)(user_profile|user_account|user_data|customer|account|employee|financial|balance|invoice|billing)", "data_sensitivity": 2.5, "data_target": "customer_data"},
      {"pattern": "(?i)(database|query|sql|table|record)", "data_sensitivity": 2.0, "data_target": "database_records"},
      {"pattern": "(?i)(file|path|directory|folder|fs)", "data_sensitivity": 1.5, "data_target": "filesystem_data"},
      {"pattern": "(?i)(repo|git|commit|branch|diff)", "data_sensitivity": 1.0, "data_target": "git_repository"}
    ],
    "operation_patterns": [
      {"pattern": "(?i)(write|create|update|insert|delete|drop|remove|modify|patch|post|put|set|edit|move|rename|append|stage|commit|reset|checkout|add)", "operation": "WRITE"},
      {"pattern": "(?i)(read|get|fetch|list|select|describe|view|show|search|query|find|summarize|inspect|log|status|diff)", "operation": "READ"}
    ],
    "action_sensitivity_patterns": [
      {"pattern": "(?i)(delete|drop|truncate|purge|destroy|kill|rmdir)", "action_sensitivity": 3.0, "action_type": "destructive_action"},
      {"pattern": "(?i)(execute|exec|run_command|shell|system_call|system_exec|system_cmd|os_system|eval)", "action_sensitivity": 3.0, "action_type": "arbitrary_execution"},
      {"pattern": "(?i)(send|email|post|upload|webhook|broadcast|transmit)", "action_sensitivity": 3.0, "action_type": "external_transmission"},
      {"pattern": "(?i)(write|update|insert|create|modify|alter|patch|edit|move|rename|append)", "action_sensitivity": 2.0, "action_type": "modify_action"},
      {"pattern": "(?i)(commit|stage|checkout|branch|reset)", "action_sensitivity": 1.5, "action_type": "version_control_action"},
      {"pattern": "(?i)(read|get|fetch|list|query|search|inspect|status|log|diff|show)", "action_sensitivity": 1.0, "action_type": "read_action"}
    ],
    "external_exposure_patterns": [
      {"pattern": "(?i)(email|smtp|mail|recipient)", "external_exposure": 3.0, "external_destination": "external_email", "action_type": "external_communication"},
      {"pattern": "(?i)(http|https|webhook|url|fetch|curl|api_call|upload|post_to)", "external_exposure": 3.0, "external_destination": "internet", "action_type": "external_network_request"},
      {"pattern": "(?i)(slack|discord|teams|notify|message)", "external_exposure": 2.5, "external_destination": "external_chat", "action_type": "external_communication"}
    ]
  },
  "default_classification": {
    "data_target": "generic_resource",
    "operation": "READ",
    "action_type": "internal_operation",
    "data_sensitivity": 0.0,
    "action_sensitivity": 0.0,
    "external_exposure": 0.0,
    "external_destination": null,
    "consumed_data_types": []
  }
}
